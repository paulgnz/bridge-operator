# DogecoinVM: Dogecoin's two-way peg on a Metal Blockchain L1.
#
# Every per-chain value the scripts use, in one place. Everything here is
# public (IDs, versions, pinned hashes). Secrets never go in this file.
# It is sourced by bash: keep it to plain NAME=value lines.

CHAIN=dogevm
CHAIN_TITLE=DogecoinVM
COIN=DOGE
# Smallest unit, for amounts the bridge takes in integers (koinu).
COIN_UNITS_PER_COIN=100000000
SITE=https://metaldoge.com

# --- The L1 on Metal mainnet (dogecoin-vm docs/TESTING.md) ------------------
L1_CHAIN_ID=2hFCfzdMmfXBxYgvvdL7BYiJAxdejyn4AksMYUM2eM5gN7Xrjy
L1_SUBNET_ID=2t2zEB1T3mNUE2WoheMFMjfhAvQJawtgiwnKPJz2NsFk7FDgyN
L1_VM_ID=mEUwHwfd8UTHf23UYkQxHvy1n1EGwWieXQnjmtzSryJRZckzu
L1_VALIDATOR_NODE_ID=NodeID-5qeQJPktXm63RrXxxkfjunFJPQCP7YeeK
L1_VALIDATION_ID=qPanCREE6TaXz1TFT2qbt9uKvjtHg1AzWNMzYnStYAeJshNmB
# Dogecoin mainnet peg address.
PEG_ADDRESS=AAvNfukpAa4iTcRJPetxuxX8XxbC5gFqUM
# The site's public read-only JSON-RPC, used by check.sh to show how far
# behind this node's copy of the L1 is.
PUBLIC_RPC_URL=https://metaldoge.com/rpc
PUBLIC_RPC_USER=public
PUBLIC_RPC_PASS=public

# --- Source: the bridge and the L1 plugin, built from a pinned commit -------
# To update: pick the new commit on BRIDGE_BRANCH (git ls-remote BRIDGE_REPO
# refs/heads/BRIDGE_BRANCH), read what changed, put its full SHA here, then
# re-run install.sh on each host. The installer checks out exactly this
# commit and refuses to build anything else.
BRIDGE_REPO=https://github.com/MetalBlockchain/dogecoin-vm
BRIDGE_BRANCH=dogecoin
BRIDGE_COMMIT=3cad3bfcb54f4f50f207c554721dfef3376b44b5
BRIDGE_BIN=dogevm
BRIDGE_CLI_PKG=./cmd/dogevm
BRIDGE_PLUGIN_PKG=./cmd/dogevm-plugin

# Environment variables the dogevm binary reads (cmd/dogevm/main.go).
ENV_VM_PREFIX=DOGEVM
ENV_COIN_PREFIX=DOGECOIN

# --- Where things live on the host ------------------------------------------
OPT_DIR=/opt/dogevm
NODE_USER=dogevm-node
NODE_SERVICE=dogevm-node
NODE_STATE=/var/lib/dogevm-node
# The ceremony's default directory and user (dogevm signer-setup init/join).
SIGNER_USER=dogevm-signer
SIGNER_SERVICE=dogevm-signer
SIGNER_DIR=/var/lib/dogevm-signer

# --- Dogecoin Core (signer role only) ---------------------------------------
COIN_NAME="Dogecoin Core"
COIN_VERSION=1.14.9
COIN_URL=https://github.com/dogecoin/dogecoin/releases/download/v1.14.9/dogecoin-1.14.9-x86_64-linux-gnu.tar.gz
# The same pin as dogecoin-vm's deploy/provision.sh.
COIN_SHA256=4f227117b411a7c98622c970986e27bcfc3f547a72bef65e7d9e82989175d4f8
COIN_TAR_DIR=dogecoin-1.14.9
COIN_HOME=/opt/dogecoin-1.14.9
COIN_DAEMON=dogecoind
COIN_CLI=dogecoin-cli
COIN_CONF_NAME=dogecoin.conf
COIN_USER=dogecoind
COIN_SERVICE=dogecoind
COIN_DATA=/var/lib/dogecoind
COIN_RPC_PORT=22555
COIN_P2P_PORT=22556
# Dogecoin Core 1.14 has one wallet; the signer imports watch-only addresses
# into it.
COIN_WALLET=
# NOT pruned: DogecoinVM's bridge looks transactions up with -txindex. The
# whole chain with txindex was about 260 GB in late 2026, and grows.
COIN_CONF_EXTRA="txindex=1
dbcache=4000
maxconnections=40"
COIN_SYNC_TIME="several hours to a day"
# check.sh warns when the newest block is older than this. Dogecoin blocks
# come about every minute.
COIN_STALE_MINUTES=30

# --- Disk, for check.sh and the installer's warning -------------------------
MIN_DISK_GB_NODE=60
MIN_DISK_GB_SIGNER=400
