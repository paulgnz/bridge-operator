# BTCVM: Bitcoin's two-way peg on a Metal Blockchain L1.
#
# Every per-chain value the scripts use, in one place. Everything here is
# public (IDs, versions, pinned hashes). Secrets never go in this file.
# It is sourced by bash: keep it to plain NAME=value lines.

CHAIN=btcvm
CHAIN_TITLE=BTCVM
COIN=BTC
# Smallest unit, for amounts the bridge takes in integers (satoshis).
COIN_UNITS_PER_COIN=100000000
SITE=https://metalbtc.com

# --- The L1 on Metal mainnet ----------------------------------------------
L1_CHAIN_ID=BYogm85qvZxwX4PitKLDPzNDbAgo61nw2NSXx5VVXyZZ8yGUK
L1_SUBNET_ID=SWJQGgyAvXY1aBczr7WupCGpLmukvP2YdXZJUvqm1td37EcJm
L1_VM_ID=kMtihm7W3KssmcJb9mzwZfC6gkiPrJhWaa5KMLHdEB9R8Q4pp
L1_VALIDATOR_NODE_ID=NodeID-HEPafTRm58szWKMBFfKSY1ALEWSKTNyYf
# The validator's registration on the P-Chain (platform.getL1Validator).
L1_VALIDATION_ID=2E6sSScTCbh42VPASdAWnsAwjvwx6K5hU8h53ro7qCpGw1GbRa
# Bitcoin mainnet peg address (from cmd/btcvm/pages/roadmap.html).
PEG_ADDRESS=bc1qlvaxxu9etgcwlt9u5wkn5pu4p28a5p4uxs088nmn6c2se3wn08eqls0cla
# The site's public read-only JSON-RPC, used by check.sh to show how far
# behind this node's copy of the L1 is.
PUBLIC_RPC_URL=https://metalbtc.com/rpc
PUBLIC_RPC_USER=public
PUBLIC_RPC_PASS=public

# --- Source: the bridge and the L1 plugin, built from a pinned commit -------
# To update: pick the new commit on BRIDGE_BRANCH (git ls-remote BRIDGE_REPO
# refs/heads/BRIDGE_BRANCH), read what changed, put its full SHA here, then
# re-run install.sh on each host. The installer checks out exactly this
# commit and refuses to build anything else.
BRIDGE_REPO=https://github.com/MetalBlockchain/btc-vm
BRIDGE_BRANCH=main
BRIDGE_COMMIT=66f440b200cfbc1d813fe5987b49b3c23bf360a0
BRIDGE_BIN=btcvm
BRIDGE_CLI_PKG=./cmd/btcvm
BRIDGE_PLUGIN_PKG=./cmd/btcvm-plugin

# Environment variables the btcvm binary reads (cmd/btcvm/main.go).
ENV_VM_PREFIX=BTCVM
ENV_COIN_PREFIX=BITCOIN

# --- Where things live on the host ------------------------------------------
OPT_DIR=/opt/btcvm
NODE_USER=btcvm-node
NODE_SERVICE=btcvm-node
NODE_STATE=/var/lib/btcvm-node
# The ceremony's default directory and user (btcvm signer-setup init/join).
SIGNER_USER=btcvm-signer
SIGNER_SERVICE=btcvm-signer
SIGNER_DIR=/var/lib/btcvm-signer

# --- Bitcoin Core (signer role only) ----------------------------------------
COIN_NAME="Bitcoin Core"
COIN_VERSION=31.1
COIN_URL=https://bitcoincore.org/bin/bitcoin-core-31.1/bitcoin-31.1-x86_64-linux-gnu.tar.gz
# From https://bitcoincore.org/bin/bitcoin-core-31.1/SHA256SUMS, whose
# signatures verify against the builder keys in bitcoin-core/guix.sigs.
# (The same pin as btcvm's deploy/provision.sh.)
COIN_SHA256=b80d9c3e04da78fb6f0569685673418cf686fadba9042d926d13fb87ff503f9e
COIN_TAR_DIR=bitcoin-31.1
COIN_HOME=/opt/bitcoin-31.1
COIN_DAEMON=bitcoind
COIN_CLI=bitcoin-cli
COIN_CONF_NAME=bitcoin.conf
COIN_USER=bitcoind
COIN_SERVICE=bitcoind
COIN_DATA=/var/lib/bitcoind
COIN_RPC_PORT=8332
COIN_P2P_PORT=8333
# The watch-only wallet the signer creates in Bitcoin Core (btcvm -btc-wallet).
COIN_WALLET=btcvm
# Pruned: Bitcoin Core downloads and checks every block but keeps only the
# newest ~60 GB. The bridge needs no -txindex (docs/BRIDGE.md).
COIN_CONF_EXTRA="prune=60000
dbcache=4000
maxconnections=40
maxuploadtarget=20000"
# Rough first-sync time, for messages.
COIN_SYNC_TIME="about a day, sometimes more"
# check.sh warns when the newest block is older than this. Bitcoin blocks
# come every ~10 minutes at random, so an hour without one does happen.
COIN_STALE_MINUTES=90

# --- Disk, for check.sh and the installer's warning -------------------------
MIN_DISK_GB_NODE=60
MIN_DISK_GB_SIGNER=150
